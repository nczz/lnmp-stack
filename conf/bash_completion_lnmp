#!/usr/bin/env bash
# lnmp command bash completion
_lnmp_completion() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "${prev}" in
        lnmp)
            COMPREPLY=( $(compgen -W "start stop restart reload status upgrade kill vhost ssl db firewall addons reset-password" -- "${cur}") )
            ;;
        vhost)
            COMPREPLY=( $(compgen -W "add del list" -- "${cur}") )
            ;;
        ssl)
            COMPREPLY=( $(compgen -W "install renew revoke list self client-upgrade" -- "${cur}") )
            ;;
        db)
            COMPREPLY=( $(compgen -W "add del list import export" -- "${cur}") )
            ;;
        upgrade)
            COMPREPLY=( $(compgen -W "plan apply" -- "${cur}") )
            ;;
        apply)
            if [[ "${COMP_WORDS[1]}" = "upgrade" ]]; then
                COMPREPLY=( $(compgen -W "outdated all nginx php db redis memcached composer wp-cli acme ext:redis ext:imagick ext:apcu ext:swoole ext:memcached ext:sodium ext:imap phpmyadmin" -- "${cur}") )
            fi
            ;;
        addons)
            COMPREPLY=( $(compgen -W "install uninstall list" -- "${cur}") )
            ;;
        add)
            # vhost add options
            if [[ "${COMP_WORDS[1]}" = "vhost" ]]; then
                COMPREPLY=( $(compgen -W "--domains --webroot --rewrite --ssl --redirect" -- "${cur}") )
            fi
            ;;
        --rewrite)
            local rules=""
            if [[ -d /usr/local/nginx/conf/rewrite ]]; then
                rules=$(ls /usr/local/nginx/conf/rewrite/ 2>/dev/null | sed 's/\.conf$//')
            fi
            COMPREPLY=( $(compgen -W "${rules}" -- "${cur}") )
            ;;
    esac
    return 0
}

complete -F _lnmp_completion lnmp
